# ---- Required ----
NODE_ENV=development
PORT=8000
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority
# Long random strings. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY_ACCESS_TOKEN=change-me
SECRET_KEY_REFRESH_TOKEN=change-me-too

# Browser origins allowed to call this API (comma separated, no trailing slash)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# ---- Email (verification + password reset codes) ----
# EMAIL is the sender address. Pick ONE of the two options below.
EMAIL=your-sender@example.com
EMAIL_FROM_NAME=Spices Gold
# Option A (recommended on Render free tier, which blocks SMTP): Brevo HTTP API
BREVO_API_KEY=
# Option B (local development): Gmail SMTP with an App Password
EMAIL_PASS=

# ---- Image uploads (products, categories, slider, avatars) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payments (optional) ----
# Leave empty to offer cash-on-delivery only. Get a key at https://dashboard.chapa.co
CHAPA_SECRET_KEY=
# Flat delivery fee in ETB added to every order
SHIPPING_FEE=0

# ---- Only used by `npm run create-admin` ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
